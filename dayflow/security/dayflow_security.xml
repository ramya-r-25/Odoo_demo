<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dayflow HRMS Security Category -->
        <record id="module_category_dayflow" model="ir.module.category">
            <field name="name">Dayflow HRMS</field>
            <field name="description">Category for managing Dayflow HRMS user access and administrative roles.</field>
            <field name="sequence">10</field>
        </record>

        <!-- Employee Access Group -->
        <record id="group_dayflow_user" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="comment">Standard employee user access for Dayflow HRMS.</field>
        </record>

        <!-- HR / Admin Access Group -->
        <record id="group_dayflow_admin" model="res.groups">
            <field name="name">HR / Administrator</field>
            <field name="category_id" ref="module_category_dayflow"/>
            <field name="implied_ids" eval="[(4, ref('group_dayflow_user'))]"/>
            <field name="comment">Full administrative access for Dayflow HRMS.</field>
        </record>
    </data>
</odoo>
