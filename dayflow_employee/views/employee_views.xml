<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_dayflow_employee_form" model="ir.ui.view">
            <field name="name">dayflow.employee.form</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <form string="Employee Profile">
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Employee Name"/>
                            </h1>
                            <h3>
                                <field name="job_position" placeholder="Job Position"/>
                            </h3>
                        </div>
                        <group>
                            <group string="Basic Details">
                                <field name="employee_id"/>
                                <field name="department"/>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                            </group>
                            <group string="Employment Details">
                                <field name="salary_structure"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Documents">
                                <field name="document_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree / List View -->
        <record id="view_dayflow_employee_tree" model="ir.ui.view">
            <field name="name">dayflow.employee.tree</field>
            <field name="model">dayflow.employee</field>
            <field name="arch" type="xml">
                <tree string="Employees">
                    <field name="employee_id"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="job_position"/>
                    <field name="department"/>
                    <field name="salary_structure"/>
                </tree>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_dayflow_employee" model="ir.actions.act_window">
            <field name="name">Employee Profiles</field>
            <field name="res_model">dayflow.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Dayflow employee profile!
                </p>
            </field>
        </record>

        <!-- Dayflow Root Menu -->
        <menuitem id="menu_dayflow_root" name="Dayflow HRMS" sequence="10"/>

        <!-- Employee Profile Submenu -->
        <menuitem id="menu_dayflow_employee_root" name="Employees" parent="menu_dayflow_root" sequence="1"/>
        <menuitem id="menu_dayflow_employee_profile" name="Employee Profiles" parent="menu_dayflow_employee_root" action="action_dayflow_employee" sequence="1"/>

    </data>
</odoo>
